# Copy to `.env` (repo root, or next to the package) or export these in your shell.
# ai_review auto-loads .env; a FILLED-IN value here wins over a shell export (empty lines don't).
# `python -m ai_review doctor` shows which .env was loaded.

# Odoo — used to pull the [task_id] ticket description + log notes for context.
# Get an API key: www.odoo.com > Preferences > Account Security > New API Key.
ODOO_URL=https://www.odoo.com
ODOO_DB=openerp
ODOO_USER=you@odoo.com
ODOO_API_KEY=

# Optional: only if R&D tasks live on a DIFFERENT Odoo than the one above.
# Any unset TASK_* var falls back to its ODOO_* counterpart.
# TASK_ODOO_URL=
# TASK_ODOO_DB=
# TASK_ODOO_USER=
# TASK_ODOO_API_KEY=

# GitHub auth is handled by the `gh` CLI (`gh auth login`), not here.
# Claude auth is handled by the `claude` CLI (your Claude Code login or ANTHROPIC_API_KEY).
